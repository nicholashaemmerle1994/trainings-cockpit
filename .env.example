# Zugangsdaten — niemals committen. `chmod 600 .env`

# intervals.icu → Settings → Developer → API Key
INTERVALS_API_KEY=
# 0 = der Athlet, dem der Key gehört
INTERVALS_ATHLETE_ID=0

# Garmin Connect → Settings → Personal API → Key anlegen
GARMIN_PERSONAL_API_KEY=

# Datenverzeichnis (Docker: /data)
# TC_DATA_DIR=./data

# Saisonziel für die Kopfzeile
# TC_GOAL_NAME=IRONMAN Kärnten-Klagenfurt
# TC_GOAL_DATE=2027-06-13
